# Which location this build renders: 'birmingham' | 'chattanooga'
NEXT_PUBLIC_LOCATION=birmingham

# Supabase (same project for both sites)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: canonical origin override. Defaults to https://<locations.domain>.
# Set on Vercel preview deployments and local dev if needed.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
